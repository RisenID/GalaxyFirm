<resources>
    <style name="Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sec-medium</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Badge.Major">
        <item name="android:background">@drawable/bg_badge_major</item>
        <item name="android:textColor">@color/status_major</item>
    </style>
    <style name="Badge.New">
        <item name="android:background">@drawable/bg_badge_new</item>
        <item name="android:textColor">@color/status_new</item>
    </style>
    <style name="Badge.Soon">
        <item name="android:background">@drawable/bg_badge_soon</item>
        <item name="android:textColor">@color/status_soon</item>
    </style>
    <style name="Badge.Failed">
        <item name="android:background">@drawable/bg_badge_failed</item>
        <item name="android:textColor">@color/status_failed</item>
    </style>
    <style name="Badge.Neutral">
        <item name="android:background">@drawable/bg_badge_neutral</item>
        <item name="android:textColor">@color/status_neutral</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
