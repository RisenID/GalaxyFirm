<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:expanded="false"
    app:showNavButtonAsBack="true"
    app:title="@string/settings_app_data_title">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="24dp">

            <dev.oneuiproject.oneui.widget.Separator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_header_backup" />

            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">

                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/row_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_oui_share_outline"
                    app:showTopDivider="false"
                    app:summary="@string/settings_export_summary"
                    app:title="@string/settings_export_title" />

                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/row_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_oui_download"
                    app:summary="@string/settings_import_summary"
                    app:title="@string/settings_import_title" />

            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <dev.oneuiproject.oneui.widget.Separator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_header_storage" />

            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">

                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/row_history_limit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_oui_time_outline"
                    app:showTopDivider="false"
                    app:title="@string/settings_history_limit_title"
                    app:userUpdatableSummary="true" />

                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/row_clear_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_oui_delete_outline"
                    app:summary="@string/settings_clear_history_summary"
                    app:title="@string/settings_clear_history_title" />

                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/row_delete_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_oui_delete_outline"
                    app:iconTint="@color/status_failed"
                    app:summary="@string/settings_delete_all_summary"
                    app:title="@string/settings_delete_all_title" />

            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</dev.oneuiproject.oneui.layout.ToolbarLayout>
