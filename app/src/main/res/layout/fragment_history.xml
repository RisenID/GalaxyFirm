<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <dev.oneuiproject.oneui.widget.MarginsTabLayout
        android:id="@+id/filter_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:seslTabStyle="Sub"
        app:tabGravity="center"
        app:tabMode="scrollable">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="All (0)" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="New (0)" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Failed (0)" />
    </dev.oneuiproject.oneui.widget.MarginsTabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <dev.oneuiproject.oneui.widget.RoundedRecyclerView
            android:id="@+id/session_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:colorBackground"
            android:paddingHorizontal="10dp"
            android:scrollbarStyle="outsideOverlay"
            app:fillHorizontalPadding="true"
            app:roundedCorners="top_left|top_right"
            tools:listitem="@layout/item_history_session" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/empty_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="72dp"
                android:paddingBottom="48dp">

                <ImageView
                    android:id="@+id/empty_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.5"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_oui_time_outline"
                    app:tint="?android:textColorSecondary" />

                <TextView
                    android:id="@+id/empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sec-medium"
                    android:gravity="center"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="19sp"
                    tools:text="@string/history_empty_title" />

                <TextView
                    android:id="@+id/empty_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="14sp"
                    tools:text="@string/history_empty_hint" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
