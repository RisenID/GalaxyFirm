<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:expanded="false"
    app:showNavButtonAsBack="true"
    app:showSwitchBar="true"
    app:title="@string/settings_auto_scan_title">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="24dp">

            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:id="@+id/card_exact_alarm_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?android:colorBackground"
                android:orientation="vertical"
                android:visibility="gone">

                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/row_exact_alarm_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_oui_error"
                    app:iconTint="@color/status_failed"
                    app:showTopDivider="false"
                    app:title="@string/settings_exact_alarm_warning" />

            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <dev.oneuiproject.oneui.widget.Separator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_scan_interval_header" />

            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">

                <dev.oneuiproject.oneui.widget.RadioItemViewGroup
                    android:id="@+id/interval_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <dev.oneuiproject.oneui.widget.RadioItemView
                        android:id="@+id/radio_10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/settings_interval_10" />

                    <dev.oneuiproject.oneui.widget.RadioItemView
                        android:id="@+id/radio_15"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/settings_interval_15" />

                    <dev.oneuiproject.oneui.widget.RadioItemView
                        android:id="@+id/radio_30"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/settings_interval_30" />

                    <dev.oneuiproject.oneui.widget.RadioItemView
                        android:id="@+id/radio_60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/settings_interval_60" />

                    <dev.oneuiproject.oneui.widget.RadioItemView
                        android:id="@+id/radio_120"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/settings_interval_120" />

                    <dev.oneuiproject.oneui.widget.RadioItemView
                        android:id="@+id/radio_180"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:title="@string/settings_interval_180" />

                </dev.oneuiproject.oneui.widget.RadioItemViewGroup>

            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <dev.oneuiproject.oneui.widget.Separator
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">

                <dev.oneuiproject.oneui.widget.SwitchItemView
                    android:id="@+id/row_wifi_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_oui_wifi"
                    app:showTopDivider="false"
                    app:summaryOff="@string/settings_wifi_only_summary"
                    app:summaryOn="@string/settings_wifi_only_summary"
                    app:title="@string/settings_wifi_only_title" />

                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/row_next_scan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    app:icon="@drawable/ic_oui_time_outline"
                    app:title="@string/settings_next_scan_title" />

            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <TextView
                android:id="@+id/tv_description"
                style="@style/OneUI.UnclickablePreferenceTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp"
                android:text="@string/settings_auto_scan_description" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</dev.oneuiproject.oneui.layout.ToolbarLayout>
